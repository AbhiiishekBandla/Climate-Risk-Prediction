# DagsHub & MLflow Configuration Template
# Copy this file to .env and fill in your actual credentials
# NOTE: .env is in .gitignore and will never be committed.

# DagsHub Credentials
DAGSHUB_USERNAME=abhishekbandla07
DAGSHUB_REPO_NAME=Climate-Risk-Prediction
DAGSHUB_USER_TOKEN=your_dagshub_token_here

# MLflow Remote Tracking (Optional - Automatically resolved if DagsHub token is present)
MLFLOW_TRACKING_URI=https://dagshub.com/abhishekbandla07/Climate-Risk-Prediction.mlflow
MLFLOW_TRACKING_USERNAME=abhishekbandla07
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here

# Fallback Settings
MLFLOW_ALLOW_FILE_STORE=true
MLFLOW_DISABLE_AGENT_HINT=1
